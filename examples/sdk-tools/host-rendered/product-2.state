{
  "schema_version": 2,
  "product_id": "org.soniclaw.workbench.polymod",
  "name": "Poly Motion",
  "parameters": {
    "limit.ceiling_db": -1.0,
    "limit.release_ms": 100.0,
    "space.damping_hz": 6000.0,
    "space.diffusion": 0.7,
    "space.mix": 0.25,
    "space.modulation": 0.3,
    "space.predelay_ms": 15.0,
    "space.rt60": 2.0,
    "voice.cutoff": 3000.0,
    "voice.gain": 0.6,
    "voice.pressure": 0.5,
    "voice.timbre": 0.7
  },
  "assets": [
    {
      "id": "grain-source",
      "path": "assets/grain-source.wav",
      "root_note": 57
    },
    {
      "id": "stereo-ir",
      "path": "assets/stereo-ir.wav",
      "root_note": 60
    }
  ],
  "zones": [],
  "nodes": [
    {
      "id": "voice",
      "kind": "poly_mod_synth",
      "settings": {},
      "input_gain": 0.0,
      "voice_modulation": {
        "envelopes": [
          {
            "attack": 0.008,
            "decay": 0.14,
            "sustain": 0.65,
            "release": 0.25
          },
          {
            "attack": 0.25,
            "decay": 0.3,
            "sustain": 0.4,
            "release": 0.5
          }
        ],
        "lfos": [
          {
            "shape": "sine",
            "rate_hz": 4.0
          },
          {
            "shape": "triangle",
            "rate_hz": 0.7
          }
        ],
        "routes": [
          {
            "source": "envelope2",
            "destination": "cutoff",
            "amount": 0.45
          },
          {
            "source": "lfo1",
            "destination": "pitch",
            "amount": 0.006
          },
          {
            "source": "velocity",
            "destination": "level",
            "amount": 0.25
          },
          {
            "source": "pressure",
            "destination": "cutoff",
            "amount": 0.3
          }
        ]
      }
    },
    {
      "id": "space",
      "kind": "fdn_reverb",
      "settings": {},
      "input_gain": 0.0
    },
    {
      "id": "limit",
      "kind": "lookahead_limiter",
      "settings": {},
      "input_gain": 0.0
    }
  ],
  "connections": [
    {
      "from": "voice",
      "to": "space",
      "gain": 1.0
    },
    {
      "from": "space",
      "to": "limit",
      "gain": 1.0
    }
  ],
  "outputs": {
    "limit": 1.0
  }
}